{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://naokijodan.github.io/account-guide-kun/data/schema.json",
  "title": "アカウント作成君 手順データ",
  "description": "eBay・Payoneerアカウント開設ウィザードの手順データ（steps.json）のスキーマ。",
  "type": "object",
  "required": ["version", "updatedAt", "phases"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "手順データのバージョン。例：2026.09.1"
    },
    "updatedAt": {
      "type": "string",
      "description": "更新日（YYYY-MM-DD）。",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/phase" }
    }
  },
  "definitions": {
    "phase": {
      "type": "object",
      "required": ["id", "pillar", "title", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pillar": {
          "type": "string",
          "enum": [
            "環境の準備",
            "eBayアカウント作成",
            "Payoneer登録",
            "eBayに戻ってカード情報・住所",
            "Payoneer本人確認書類",
            "完了チェック・セラーポータル"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "site",
        "title",
        "studentText",
        "image",
        "links",
        "pasteFields",
        "branches",
        "checklist"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "site": {
          "type": "string",
          "enum": ["ebay", "payoneer", "general"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "studentText": {
          "type": "string",
          "description": "受講生向けの平易な案内文。空文字は不可。",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "description": "案内画像（見本スクリーンショット）の相対パス。画像なしは空文字。値がある場合は images/ 直下のファイル名のみ許可（上位階層への移動・追加のディレクトリ階層・URL・data:スキームは不可）。",
          "pattern": "^$|^images/[A-Za-z0-9][A-Za-z0-9._-]*\\.(png|jpg|jpeg|webp)$"
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/definitions/link" }
        },
        "pasteFields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "firstName",
              "lastName",
              "fullNameFirstLast",
              "fullNameUpperFirstLast",
              "fullNameUpperLastFirst",
              "addressLine1",
              "streetNumbersOnly",
              "addressLine2",
              "city",
              "state",
              "zipDash",
              "zipDigits",
              "phoneIntl",
              "phoneNational",
              "phoneDomestic",
              "nameKatakanaFirst",
              "nameKatakanaLast",
              "nameKatakanaFull"
            ]
          }
        },
        "branches": {
          "type": "array",
          "items": { "$ref": "#/definitions/branch" }
        },
        "checklist": {
          "type": "boolean"
        },
        "notice": {
          "type": "string",
          "description": "任意フィールド。画面共有の一時停止など、強調表示したい注意文。",
          "minLength": 1
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "branch": {
      "type": "object",
      "required": ["condition", "text"],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
